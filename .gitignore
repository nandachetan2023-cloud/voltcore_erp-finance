# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep the committed template, ignore real secrets)
.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
/local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
/test
/prompt

# package manager: bun is canonical, do not commit the npm lockfile
/package-lock.json

# local databases (schema lives in prisma/schema.prisma; rebuild with db:push + db:seed)
*.db
*.db-journal
prisma/db/

# infra runtime artifacts
.accesslog
.stats
.config_backup.json

server.log
# Skills directory
/skills/